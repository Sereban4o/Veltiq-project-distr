APP_NAME=Veltiq project
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

BROADCAST_DRIVER=reverb
REVERB_APP_ID=chat-app
REVERB_APP_KEY=chat-key
REVERB_APP_SECRET=chat-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Error tracking (Flare, optional) ───────────────────────────────────────
# Create a project at https://flareapp.io and paste the API key to report errors.
# FLARE_KEY=
# FLARE_REPORT_QUERY_BINDINGS=false
# FLARE_SEND_LOGS_AS_EVENTS=true

# ─── Queue monitoring (Horizon) ─────────────────────────────────────────────
HORIZON_PREFIX=veltiq_horizon:

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=veltiq_project
DB_USERNAME=postgres
DB_PASSWORD=secret

CACHE_STORE=redis
CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

QUEUE_CONNECTION=redis
QUEUE_RETRY_AFTER=90

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=secret

# Prefix for issued Sanctum tokens (helps secret scanners detect leaked tokens)
# SANCTUM_TOKEN_PREFIX=tsb_

# ─── File storage (optional; normally configured in the admin panel) ───
# Network storage address and credentials. When set via env they act as the
# default; the admin panel stores its own values (password encrypted).
# STORAGE_BROWSER_ADDRESS=smb://host/share
# STORAGE_BROWSER_USERNAME=
# STORAGE_BROWSER_PASSWORD=
# STORAGE_BROWSER_DOMAIN=
# STORAGE_BROWSER_CONNECT_TIMEOUT=10
# STORAGE_BROWSER_READ_TIMEOUT=60
# STORAGE_BROWSER_VERIFY_TLS=true
# STORAGE_BROWSER_SMB_MIN_PROTOCOL=SMB2
# STORAGE_BROWSER_SMB_MAX_PROTOCOL=SMB3

