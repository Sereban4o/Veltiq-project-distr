# ─────────────────────────────────────────────────────────────────────────────
# Production environment for Veltiq project
# Copy to backend/.env.production and fill in the secrets:
#   cp backend/.env.production.example backend/.env.production
#
# Generate APP_KEY:
#   php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME=Veltiq project
APP_VERSION=1.0.0
# Reopen the web installer even when the database already looks installed
# (reinstall). Keep off: a wrongly opened wizard on a live install is dangerous.
# INSTALL_FORCE=false
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://veltiq.ru

# Deploy identifier (`git describe --tags --always`). Compared against the last
# reindexed release so `search:reindex-if-stale` rebuilds Meilisearch after a
# deploy. Leave empty to fall back to a source-tree mtime fingerprint.
APP_RELEASE=

# Disable public self-registration in production (users are created in admin)
ALLOW_REGISTRATION=false

LOG_CHANNEL=stack
LOG_LEVEL=error

# ─── Database ────────────────────────────────────────────────────────────────
# POSTGRES_*  -> used by the postgres container
# DB_*        -> used by Laravel (must match POSTGRES_*)
#
# The product also supports MySQL 8 / MariaDB 10.6+ (DB_CONNECTION=mysql,
# DB_PORT=3306) and SQLite. In the bundled Docker stack PostgreSQL is the
# default; on a bare-metal host the database engine, database name and site
# administrator can be chosen in the web installer (/install, docs/15-installer.md).
# For MySQL set DB_CONNECTION=mysql and the matching DB_HOST/DB_PORT/DB_DATABASE/
# DB_USERNAME/DB_PASSWORD values; POSTGRES_* then stay unused.
POSTGRES_DB=veltiq_project
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=veltiq_project
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# ─── Cache / Session / Queue ─────────────────────────────────────────────────
CACHE_STORE=redis
CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
# Set to veltiq.ru and SESSION_SECURE_COOKIE=true once HTTPS is enabled.
SESSION_DOMAIN=null
QUEUE_CONNECTION=redis

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# ─── Broadcasting (Laravel Reverb) ───────────────────────────────────────────
BROADCAST_DRIVER=reverb
REVERB_APP_ID=chat-app
# Keep in sync with the nginx image build arg (VITE_REVERB_KEY).
REVERB_APP_KEY=chat-key
REVERB_APP_SECRET=CHANGE_ME_REVERB_SECRET
# Internal host: the app publishes events to the reverb container.
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# ─── Sanctum / CORS ──────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=veltiq.ru
CORS_ALLOWED_ORIGINS=https://veltiq.ru
# Prefix for issued Sanctum tokens (helps secret scanners detect leaked tokens)
SANCTUM_TOKEN_PREFIX=tsb_

# ─── Search ──────────────────────────────────────────────────────────────────
# The Meilisearch image is pinned to v1.56.1 in docker-compose.prod.yml to match
# the existing index format; upgrade only via dump/restore + `search:reindex`
# (see DEPLOY.md Шаг 19.6).
MEILISEARCH_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=CHANGE_ME_MEILI_KEY
MEILI_NO_ANALYTICS=true
# Scout reads MEILISEARCH_KEY; when it is empty/missing it falls back to
# MEILI_MASTER_KEY above (same env_file feeds app/worker/meilisearch).
# MEILISEARCH_KEY=
SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true

# ─── Queue monitoring (Horizon) ──────────────────────────────────────────────
# Prefix for Horizon metrics keys; keep unique per environment.
HORIZON_PREFIX=veltiq_horizon:

# ─── Error tracking (Flare) ──────────────────────────────────────────────────
# Set FLARE_KEY to a project key from https://flareapp.io to report exceptions
# from web requests and queued jobs; leave it empty to disable reporting.
# After editing: `php artisan config:clear && php artisan config:cache` and
# recreate app/worker/reverb (see DEPLOY.md Шаг 19.5).
FLARE_KEY=
FLARE_REPORT_QUERY_BINDINGS=false
FLARE_SEND_LOGS_AS_EVENTS=true

# ─── Push via ntfy (Firebase-free) ──────────────────────────────────────────
# Internal URL used by the backend to publish push messages
NTFY_URL=http://ntfy:80
NTFY_TOPIC_PREFIX=tasksbase-user-
# ntfy authentication (must match the user created inside the ntfy container)
NTFY_USER=tasksbase
NTFY_PASSWORD=tasksbase
# NTFY_TOKEN=            # optional access token instead of user/password

# ─── ONLYOFFICE Document Server (Office-like editing of real documents) ───
ONLYOFFICE_ENABLED=true
# URL of the Document Server as seen BY THE BROWSER.
# Keep it host-relative ("/onlyoffice"): nginx serves that path by proxying to
# the `onlyoffice` container (nginx/prod/default.conf), so the editor is loaded
# from the same origin the user opened the app with — LAN address, public IP or
# domain all work, no extra port and no mixed-content issues.
# An absolute URL (http://HOST:8082) also works, but then the BROWSER must be
# able to reach that host:port — a public IP is NOT reachable from the LAN on
# most routers, which breaks the editor there. "localhost" never works: it
# points at the user's own machine.
ONLYOFFICE_URL=/onlyoffice
# URL the Document Server uses to reach this backend (same docker network)
ONLYOFFICE_CALLBACK_BASE_URL=http://nginx
# Shared HS256 secret; must equal JWT_SECRET of the ONLYOFFICE container
ONLYOFFICE_JWT_SECRET=CHANGE_ME_ONLYOFFICE_JWT_SECRET

# ─── AI assistant (local Ollama) ─────────────────────────────────────────────
# Enables "Ask the knowledge base". Retrieval reuses the permission-aware search
# index; generation runs on a local Ollama server so data never leaves the infra.
AI_ENABLED=false
# Base URL of the Ollama server reachable from the backend container. Start it
# with `docker compose -f docker-compose.ollama.yml up -d` (see DEPLOY.md).
OLLAMA_URL=http://ollama:11434
# Model must be pulled on the server once: `docker compose exec ollama ollama pull llama3.1`
AI_MODEL=llama3.1
AI_TIMEOUT=120
AI_MAX_SOURCES=8
# Show the "sources" block under an answer. Citation markers like [1] stay in
# the text either way; an administrator can flip this in the admin UI.
AI_SHOW_SOURCES=true
# Sections the assistant may read (AiRetriever::TYPES), comma separated. Empty =
# all sections. Chat messages are never searchable. The admin UI overrides this.
AI_SECTIONS=
# Role names allowed to use the assistant, comma separated. Empty = everyone.
AI_ROLES=
# External fallback. Off by default: with the flag cleared no outbound request
# is made at all. AI_WEB_PROVIDER picks the mechanism:
#   fetch   — download http(s) links the question itself contains, allowlisted
#             hosts only, no search engine (nothing but the page request leaves);
#   searxng — ask a self-hosted SearXNG, question text only;
#   both    — try the mentioned links first, then fall back to a search.
AI_WEB_ENABLED=false
AI_WEB_PROVIDER=fetch
# SearXNG base URL (docker-compose.searxng.yml, internal network only).
AI_WEB_URL=http://searxng:8080
# Hosts allowed in fetch mode (comma separated). Empty disables reading.
AI_WEB_DOMAINS=
AI_WEB_TIMEOUT=8
AI_WEB_RESULTS=3
AI_WEB_MAX_CHARS=4000

# ─── Compiled core service (Go) ──────────────────────────────────────────────
# Ships algorithmically valuable logic as a binary instead of readable PHP
# (see /core). Internal-only container; CORE_URL is reachable over the Docker
# network. CORE_TOKEN is the shared secret both sides must agree on — set it here
# and pass the file to compose (`--env-file backend/.env.production`).
# Leave CORE_URL empty to keep algorithm in PHP only (the PHP implementation is
# always available as a fallback).
CORE_URL=http://core:8080
CORE_TOKEN=CHANGE_ME_CORE_TOKEN
CORE_TIMEOUT=3
# 5 подряд ошибок → вызовы пропускаются на 60 с (без сетевой попытки).
CORE_BREAKER_THRESHOLD=5
CORE_BREAKER_COOLDOWN=60

# ─── Licensing (docs/12-licensing.md) ────────────────────────────────────────
# This product is a CMS that does not work without a license: without one the API
# answers 403 `license_required` and only the admin panel stays reachable
# (activation, modules, users). Enforcement is built in and cannot be turned off
# via the environment.
#
# LICENSE_PUBLIC_KEY is the VENDOR public key (base64); the core public key is
# pinned automatically from the core on first use.
#
# The vendor key is normally PINNED INTO THE CORE BINARY at build time, not read
# from this file:
#   LICENSE_PUBLIC_KEY_B64=<base64> docker compose -f docker-compose.prod.yml build core
# The binary ignores this variable unless LICENSE_ALLOW_KEY_OVERRIDE=true is set
# as well (development and self-hosted license servers only). Keeping the key out
# of the environment stops an operator from substituting their own key and
# self-signing a license — and a lost/refreshed .env cannot break licensing.
# PHP still reads it from here as one of the trusted module signing keys.
LICENSE_PUBLIC_KEY=
# Development / self-hosted LK only: let the environment key replace the pinned
# one. Never set this in a customer installation.
# LICENSE_ALLOW_KEY_OVERRIDE=true

# Vendor license server (Veltiq LK: https://lk.veltiq.ru). The Go core posts
# to <LICENSE_SERVER_URL>/v1/heartbeat, so include the /api suffix.
LICENSE_SERVER_URL=https://lk.veltiq.ru/api
# Project machine token = `projects.api_token` from the LK admin.
LICENSE_PROJECT_TOKEN=
# Optional: stronger install binding for new deployments.
# CORE_FINGERPRINT_MODE=v2
# CORE_INSTALL_ID=

# ─── Extensions (docs/11-extensions.md) ────────────────────────────────────────────
# Vendor extensions live inside the image; third-party extensions live in the `modules`
# directory below. A disabled module closes its whole HTTP surface (403).
# EXTENSIONS_ALLOW_UNSIGNED=true is developer mode for unsigned third-party extensions:
# they are ordinary PHP with full access to data and files, so enable it only for
# a trusted operator. Signed extensions carry a `signature` and are verified against
# the vendor public key above.
EXTENSIONS_PATH=/var/www/extensions
EXTENSIONS_ALLOW_UNSIGNED=false

# Trusted signing keys of module authors: `kid=base64key` pairs, comma separated.
# The vendor key (LICENSE_PUBLIC_KEY) is always trusted as `vendor`. A manifest may
# carry `signature.kid` to pick one of these keys; get the value from
# `php tools/sign_module.php <module.json> <key> <kid>`.
EXTENSIONS_TRUSTED_KEYS=

# ─── API rate limiting ───────────────────────────────────────────────────────
# Requests per minute for the API group, per authenticated user (or per IP for
# guests). Raise it if the SPA/chat polling trips 429 (chat polls messages every
# 5s). Default: 600.
THROTTLE_API_PER_MINUTE=600


# в”Ђв”Ђв”Ђ System updates (central service: https://update.veltiq.ru) в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
# 'client' enables version checks; 'disabled' performs no network calls.
UPDATE_SERVICE_MODE=client
# Base URL WITHOUT /api: the client appends /system-updates/api/latest.
UPDATE_SERVICE_URL=https://update.veltiq.ru
# Per-installation token issued in the update-service admin (revocable).
UPDATE_SERVICE_TOKEN=
UPDATE_SERVICE_CHANNEL=stable
# Empty в†’ falls back to APP_VERSION.
UPDATE_SERVICE_CURRENT_VERSION=
UPDATE_SERVICE_CACHE_TTL=600
UPDATE_SERVICE_TIMEOUT=10
# Keep off until the deploy command is verified on the box.
UPDATE_SERVICE_ALLOW_APPLY=false
# Example: docker compose pull && docker compose up -d && php artisan migrate --force
UPDATE_SERVICE_APPLY_COMMAND=