# Variables for Docker Compose interpolation (copy to `.env` in this directory).
#
# The file is optional: the default stack keeps using the local `storage_data`
# volume. It is required for the production stack (`docker-compose.prod.yml`) and
# for the optional network storage overrides (`docker-compose.storage-smb.yml`,
# `docker-compose.storage-nfs.yml`).
#
# Each server configures its own share here; nothing is hardcoded in the code.

# ─── Production stack (docker-compose.prod.yml) ─────────────────────────────
# Pins volume/network names (`tasksbase_pgdata`, `tasksbase_storage_data`,
# network `tasksbase_default`), so they do not depend on the checkout directory.
# The OnlyOffice/Ollama overlays expect the `tasksbase_default` network.
COMPOSE_PROJECT_NAME=tasksbase

# Baked into the SPA at build time by `nginx/Dockerfile` (build arg
# VITE_REVERB_KEY). Compose reads it from this file, NOT from
# backend/.env.production — it must match REVERB_APP_KEY of the backend,
# otherwise WebSocket authorisation fails.
REVERB_APP_KEY=chat-key

# Fingerprint of the deployed release: `search:reindex-if-stale` compares it to
# decide whether to rebuild the Meilisearch indexes after a deploy (usually the
# git tag). Optional — without it the newest mtime of app/ is used.
APP_RELEASE=

# Where the network share is mounted inside the containers.
# This is the path to enter in the admin panel → «Файловое хранилище».
FILE_STORAGE_MOUNT_PATH=/mnt/file-storage

# UNC device of the share, e.g. //192.168.0.8/сотрудники
FILE_STORAGE_SMB_DEVICE=

# ─── Authentication ──────────────────────────────────────────────────────────
# Login and password for the share. Leave both empty for guest access
# (the username then defaults to "guest").
FILE_STORAGE_SMB_USERNAME=
FILE_STORAGE_SMB_PASSWORD=

# SMB protocol version and file ownership inside the containers.
# `uid`/`gid` should match the PHP-FPM user (www-data => 33 on Debian images).
FILE_STORAGE_SMB_VERSION=3.0
FILE_STORAGE_SMB_UID=33
FILE_STORAGE_SMB_GID=33
FILE_STORAGE_SMB_FILE_MODE=0775
FILE_STORAGE_SMB_DIR_MODE=0775

# Extra mount options appended as-is; must start with a comma when used,
# e.g. ,domain=CORP,sec=ntlmssp
FILE_STORAGE_SMB_EXTRA_OPTIONS=

# ─── NFS (docker-compose.storage-nfs.yml) ────────────────────────────────────
# NFS is not an in-app address: mount it via Docker and use the legacy path.
# The host needs an NFS client (`nfs-common` / `nfs-utils`).
# Device and host: 192.168.0.10:/export/storage
FILE_STORAGE_NFS_DEVICE=
FILE_STORAGE_NFS_HOST=
# NFSv4 is preferred; v3 also needs rpcbind/lockd on the host.
FILE_STORAGE_NFS_VERSION=4.1
# Ensure the export allows writes for uid/gid 33 (www-data) — e.g. export with
# all_squash,anonuid=33,anongid=33 or grant 33:33 on the server side.

# ─── ONLYOFFICE Document Server ──────────────────────────────────────────────
# Shared JWT secret passed to the ONLYOFFICE container (docker-compose.onlyoffice.yml)
ONLYOFFICE_JWT_SECRET=CHANGE_ME_ONLYOFFICE_JWT_SECRET
